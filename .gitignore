# Ignore the action-runner/ directory used by the GitHub Actions runner
# to build and deploy to GitHub Pages
action-runner/
.DS_Store
*.nds
# LEGAL: never commit ROMs, BIOS dumps, or firmware. See NOTICE.md.
*.gba
*.nds
*.dsi
*.srl
*.rom
*.sav
*.dsv
bios*.bin
*bios.bin
firmware*.bin
binaries/

# ...but the BSD clean-room FreeBIOS IS legally redistributable. Keep it.
!wasmelonDS/freebios/drastic_bios_arm7.bin
!wasmelonDS/freebios/drastic_bios_arm9.bin

# ...and the GPLv2 open-source GBA BIOS from ez-me/gba-bios is likewise a
# from-scratch reimplementation, not a Nintendo dump. Legally redistributable
# (full source: https://github.com/ez-me/gba-bios). Keep it.
!frontend/public/static/gba/freebios/gba_freebios.bin
